# Copy to .env and fill in as needed. All variables are optional except
# whichever LLM key you enable via LLM_PROVIDER.

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
HYBRID_ALPHA=0.5
TOP_K=5

# "none" (default) = retrieval only, no LLM call.
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
